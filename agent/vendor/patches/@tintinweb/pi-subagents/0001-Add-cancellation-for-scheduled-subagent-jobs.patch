+  // ---- manage_schedule tool ----
+
+  // Registered only when scheduling is enabled, mirroring the schedule param.
+  // This is the programmatic counterpart to `/agents → Scheduled jobs`: it lets
+  // the model cancel (or pause) a job it created without a human at the menu,
+  // and gives an orchestrating extension a tool-level path alongside the RPCs.
+  if (isSchedulingEnabled()) {
+    registerToolReportingUsage(defineTool({
+      name: SUBAGENT_TOOL_NAMES.MANAGE_SCHEDULE,
+      label: "Manage Scheduled Jobs",
+      description:
+        "List, cancel, pause, or resume this session's scheduled subagent jobs (the jobs created by passing `schedule` to the Agent tool). " +
+        "Cancelling removes the job so it never fires again and aborts its in-flight run, if one is running.",
+      promptSnippet: "List or cancel scheduled subagent jobs",
+      parameters: Type.Object({
+        action: Type.Union(
+          [
+            Type.Literal("list"),
+            Type.Literal("cancel"),
+            Type.Literal("pause"),
+            Type.Literal("resume"),
+          ],
+          { description: "`list` shows every job; `cancel`/`pause`/`resume` act on `job_id`." },
+        ),
+        job_id: Type.Optional(
+          Type.String({
+            description: "Job id or name. Required for cancel/pause/resume.",
+          }),
+        ),
+      }),
+      execute: async (_toolCallId, params, _signal, _onUpdate, _ctx) => {
+        if (!scheduler.isActive()) {
+          return textResult("Scheduler is not active in this session yet. Try again after the session has fully started.");
+        }
+        const action = params.action as string;
+        if (action === "list") {
+          const jobs = scheduler.list();
+          if (jobs.length === 0) return textResult("No scheduled jobs in this session.");
+          const blocks = jobs.map(job => {
+            const next = scheduler.getNextRun(job.id);
+            return [
+              `${job.enabled ? "[enabled]" : "[paused]"}  ${job.name}  (id: ${job.id})`,
+              `  schedule: ${job.schedule} (${job.scheduleType}) | runs: ${job.runCount}${job.maxRuns != null ? `/${job.maxRuns}` : ""}`,
+              `  last: ${job.lastRun ?? "—"} (${job.lastStatus ?? "—"}) | next: ${next ?? "—"}`,
+              job.cancelOn ? `  auto-cancel on output containing: ${job.cancelOn}` : "",
+            ].filter(Boolean).join("\n");
+          });
+          return textResult(`Scheduled jobs (${jobs.length}):\n\n${blocks.join("\n\n")}`);
+        }
+        if (!params.job_id) {
+          return textResult(`\`job_id\` is required for action "${action}".`);
+        }
+        if (action === "cancel") {
+          const result = scheduler.cancelJob(params.job_id);
+          if (!result.ok) return textResult(result.error);
+          return textResult(`Cancelled scheduled job "${result.job.name}" (id: ${result.job.id}). It will not fire again.`);
+        }
+        if (action === "pause" || action === "resume") {
+          const result = scheduler.setJobEnabled(params.job_id, action === "resume");
+          if (!result.ok) return textResult(result.error);
+          return textResult(`${action === "pause" ? "Paused" : "Resumed"} scheduled job "${result.job.name}" (id: ${result.job.id}).`);
+        }
+        return textResult(`Unknown action "${action}". Use list, cancel, pause, or resume.`);
+      },
+    }));
+  }
+
