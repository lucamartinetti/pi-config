# Applies to every npm command run in agent/vendor, including Dependabot's.
# Dependency lifecycle scripts never run; vendored packages need none.
ignore-scripts=true
# Keep package.json pins exact.
save-exact=true
# Peers (@earendil-works/*, typebox) are supplied by pi itself and must not
# be installed alongside the extensions.
legacy-peer-deps=true
audit=false
fund=false
